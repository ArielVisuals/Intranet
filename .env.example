# Copia este archivo a ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" a Git — solo este .env.example.

# Clave secreta de Django. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-secreta-por-una-real

# "True" en desarrollo local, "False" en producción.
DEBUG=True

# Hosts permitidos (separados por coma). En desarrollo: localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Configuración de base de datos para producción ---
# En desarrollo usamos SQLite (no necesitas llenar esto).
# Para cambiar a PostgreSQL, descomenta y llena:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=intranet_db
# DB_USER=tu_usuario
# DB_PASSWORD=tu_contraseña
# DB_HOST=localhost
# DB_PORT=5432
